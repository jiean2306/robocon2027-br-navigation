<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="robocon_2027_field_v2">

    <!-- Physics and gravity -->
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo systems -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Sun lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <direction>-0.5 0.2 -0.8</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- ================================= -->
    <!-- 1. GROUND FIELD                   -->
    <!-- ================================= -->

    <model name="ground_field">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>

      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>11 11 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>11 11 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================= -->
    <!-- 2. LEVEL 1                       -->
    <!-- ================================= -->

    <!--
      Appendix Figure 3.6:
      L1 dimensions = 6000 x 6000 mm
      L1 top elevation = 600 mm

      Modelled as a solid block for this
      initial field geometry.
    -->

    <model name="level_1">
      <static>true</static>
      <pose>0 0 0.3 0 0 0</pose>

      <link name="platform">
        <collision name="l1_collision">
          <geometry>
            <box>
              <size>6 6 0.6</size>
            </box>
          </geometry>
        </collision>

        <visual name="l1_visual">
          <geometry>
            <box>
              <size>6 6 0.6</size>
            </box>
          </geometry>

          <material>
            <ambient>0.55 0.32 0.22 1</ambient>
            <diffuse>0.72 0.48 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================= -->
    <!-- 3. LEVEL 2                       -->
    <!-- ================================= -->

    <!--
      Appendix Figures 3.4 and 3.6:
      L2 dimensions = 3000 x 3000 mm
      L2 thickness = 300 mm
      L2 top elevation = 900 mm
    -->

    <model name="level_2">
      <static>true</static>
      <pose>0 0 0.75 0 0 0</pose>

      <link name="platform">
        <collision name="l2_collision">
          <geometry>
            <box>
              <size>3 3 0.3</size>
            </box>
          </geometry>
        </collision>

        <visual name="l2_visual">
          <geometry>
            <box>
              <size>3 3 0.3</size>
            </box>
          </geometry>

          <material>
            <ambient>0.30 0.35 0.55 1</ambient>
            <diffuse>0.40 0.48 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ================================= -->
    <!-- 4. RED TEAM ACCESS STRUCTURES     -->
    <!-- ================================= -->

    <!-- Stair 1: 300 mm long, 150 mm high -->
    <model name="red_stair_1">
      <static>true</static>
      <pose>-3.5 -2.55 0.075 0 0 0</pose>
      <link name="step">
        <collision name="collision">
          <geometry><box><size>1 0.3 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.3 0.15</size></box></geometry>
          <material><ambient>0.65 0.25 0.2 1</ambient><diffuse>0.8 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Stair 2: 300 mm long, 300 mm total height -->
    <model name="red_stair_2">
      <static>true</static>
      <pose>-3.5 -2.25 0.15 0 0 0</pose>
      <link name="step">
        <collision name="collision">
          <geometry><box><size>1 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.3 0.3</size></box></geometry>
          <material><ambient>0.65 0.25 0.2 1</ambient><diffuse>0.8 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Stair 3: 300 mm long, 450 mm total height -->
    <model name="red_stair_3">
      <static>true</static>
      <pose>-3.5 -1.95 0.225 0 0 0</pose>
      <link name="step">
        <collision name="collision">
          <geometry><box><size>1 0.3 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.3 0.45</size></box></geometry>
          <material><ambient>0.65 0.25 0.2 1</ambient><diffuse>0.8 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Red Transfer Area: top at 600 mm -->
    <model name="red_transfer_area">
      <static>true</static>
      <pose>-3.5 -1.3 0.3 0 0 0</pose>
      <link name="platform">
        <collision name="collision">
          <geometry><box><size>1 1 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 0.6</size></box></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>1 0.68 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Red ramp: 3500 mm horizontal length, 600 mm rise -->
    <model name="red_ramp">
      <static>true</static>
      <pose>-3.5 0.95 0.3 -0.1698 0 0</pose>
      <link name="ramp">
        <collision name="collision">
          <geometry><box><size>1 3.551 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 3.551 0.08</size></box></geometry>
          <material><ambient>0.55 0.3 0.18 1</ambient><diffuse>0.75 0.45 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================= -->
    <!-- 5. BLUE TEAM ACCESS STRUCTURES    -->
    <!-- ================================= -->

    <model name="blue_stair_1">
      <static>true</static>
      <pose>3.5 -2.55 0.075 0 0 0</pose>
      <link name="step">
        <collision name="collision">
          <geometry><box><size>1 0.3 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.3 0.15</size></box></geometry>
          <material><ambient>0.15 0.3 0.7 1</ambient><diffuse>0.25 0.45 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_stair_2">
      <static>true</static>
      <pose>3.5 -2.25 0.15 0 0 0</pose>
      <link name="step">
        <collision name="collision">
          <geometry><box><size>1 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.3 0.3</size></box></geometry>
          <material><ambient>0.15 0.3 0.7 1</ambient><diffuse>0.25 0.45 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_stair_3">
      <static>true</static>
      <pose>3.5 -1.95 0.225 0 0 0</pose>
      <link name="step">
        <collision name="collision">
          <geometry><box><size>1 0.3 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.3 0.45</size></box></geometry>
          <material><ambient>0.15 0.3 0.7 1</ambient><diffuse>0.25 0.45 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_transfer_area">
      <static>true</static>
      <pose>3.5 -1.3 0.3 0 0 0</pose>
      <link name="platform">
        <collision name="collision">
          <geometry><box><size>1 1 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 0.6</size></box></geometry>
          <material><ambient>0.15 0.55 0.8 1</ambient><diffuse>0.2 0.7 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_ramp">
      <static>true</static>
      <pose>3.5 0.95 0.3 -0.1698 0 0</pose>
      <link name="ramp">
        <collision name="collision">
          <geometry><box><size>1 3.551 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 3.551 0.08</size></box></geometry>
          <material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.3 0.55 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
