<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>br_nav_sandbox</name>
  <version>0.1.0</version>
  <description>
    ABU Robocon 2027 Builder Robot (BR) multi-level (Ground / L1 / L2) autonomous
    navigation sandbox: Rulebook V1.1 146-primitive arena, Fusion 360 BR v7 CAD,
    3-floor Bayesian LiDAR occupancy mapper, vectorized EDT traversability costmap
    with Gazebo/RViz2 halo overlays, cost-aware A* pathfinder, 3-stage wheel-lift
    climber, and full match gameplay director for ROS 2 Jazzy and Gazebo Harmonic.
  </description>
  <maintainer email="team@aburobocon2027.local">ABU Robocon 2027 BR Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
