Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /1. Occupancy Grid Map (/br_occupancy_grid)1
        - /2. Traversability Costmap Halo (/br_traversability_viz)1
        - /9. A* Planned Path (/br_planned_path)1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
      - /Saved1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.28
      Cell Size: 1.0
      Class: rviz_default_plugins/Grid
      Color: 150; 150; 156
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Arena Reference Grid (1m cells)
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0.0
      Plane: XY
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.78
      Color Scheme: map
      Class: rviz_default_plugins/Map
      Draw Behind: false
      Enabled: true
      Name: 1. Occupancy Grid Map (/br_occupancy_grid)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_occupancy_grid
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_occupancy_grid_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 2. Traversability Costmap Halo (/br_traversability_viz)
      Namespaces:
        traversability_halo: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_traversability_viz
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 3. 3D Arena Reference (Toggle for Pure 2D Map)
      Namespaces:
        robocon_2027_arena: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_arena_markers
      Value: true
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 0; 245; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: 4. Live 2D LiDAR Scan (/scan)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 5. LiDAR Dynamic Obstacles (Diff vs Static Map)
      Namespaces:
        lidar_dynamic_obstacles: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_dynamic_obstacles
      Value: true
    - Alpha: 0.95
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
      Name: 6. BR v7 Robot Model
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1.0
      Class: rviz_default_plugins/Polygon
      Color: 30; 255; 80
      Enabled: true
      Name: 7. BR Footprint (0.70m x 0.70m)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_footprint_polygon
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 8. Match Robots (OUR TR + ENEMY BR & TR)
      Namespaces:
        enemy_robots: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_enemy_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 8b. Live Match Towers, Blocks & Mustika (/br_mission_objects)
      Namespaces:
        mission_banner: true
        mission_objects: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_mission_objects
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 110
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.08
      Length: 0.15
      Line Style: Billboards
      Line Width: 0.06
      Name: 9. A* Planned Path (/br_planned_path)
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Color: 255; 85; 255
      Pose Style: Arrows
      Radius: 0.03
      Shaft Diameter: 0.04
      Shaft Length: 0.07
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_planned_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 10. A* Explored Nodes & Endpoints
      Namespaces:
        astar_endpoints: true
        astar_explored_cells: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_explored_nodes
      Value: true
    - Alpha: 0.35
      Color Scheme: costmap
      Class: rviz_default_plugins/Map
      Draw Behind: false
      Enabled: false
      Name: 11. Raw Nav2 Costmap Grid (Optional Toggle)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_traversability_costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /br_traversability_costmap_updates
      Use Timestamp: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 33; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.0685
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: 2D Top-Down Mapping (North-Up)
      Near Clip Distance: 0.01
      Scale: 62
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0.0
      Y: 0.0
    Saved:
      - Angle: 0
        Class: rviz_default_plugins/TopDownOrtho
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Invert Z Axis: false
        Name: 2D Top-Down Mapping (North-Up)
        Near Clip Distance: 0.01
        Scale: 62
        Target Frame: <Fixed Frame>
        Value: TopDownOrtho (rviz_default_plugins)
        X: 0.0
        Y: 0.0
      - Class: rviz_default_plugins/Orbit
        Distance: 13.5
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 0.0
          Y: -0.3
          Z: 0.4
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: 3D Arena + Traversability Orbit
        Near Clip Distance: 0.01
        Pitch: 0.72
        Target Frame: <Fixed Frame>
        Value: Orbit (rviz_default_plugins)
        Yaw: 4.712389
Window Geometry:
  Displays:
    collapsed: false
  Height: 940
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 960
  X: 880
  Y: 30
